[node name="Session" type="Node" parent="."]
script = ExtResource("3_session")

[node name="Overlays" type="Node3D" parent="."]
script = ExtResource("7_overlays")

[node name="Focus" type="Node3D" parent="."]

[node name="Camera" type="Camera3D" parent="."]
