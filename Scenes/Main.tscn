[sub_resource type="ProceduralSkyMaterial" id="sky_mat"]
sky_top_color = Color(0.32, 0.5, 0.75, 1)
sky_horizon_color = Color(0.7, 0.78, 0.85, 1)
ground_bottom_color = Color(0.05, 0.12, 0.2, 1)
ground_horizon_color = Color(0.7, 0.78, 0.85, 1)

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_mat")

[sub_resource type="Environment" id="env"]
background_mode = 2
sky = SubResource("sky")
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.7, 0.78, 0.85, 1)
fog_density = 5e-05

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.642788, 0.766044, 0, -0.766044, 0.642788, 0, 100, 0)
shadow_enabled = true

[node name="Ocean" type="MeshInstance3D" parent="."]
