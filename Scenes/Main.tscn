[node name="Ships" type="Node3D" parent="."]
script = ExtResource("2_fleet")

[node name="Codec" type="Node" parent="."]
script = ExtResource("4_codec")
codec_manifest_path = "res://config/codec_manifest.json"

[node name="Sim" type="Node" parent="."]
